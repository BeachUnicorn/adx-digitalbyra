# Copy to .env and fill in. NEVER commit the real .env.
# One .env per site. On the server it lives at:
#   /home/djangouser/sites/<site>/.env   (chmod 600)

# Which settings module to load. Maps to config/settings/<name>.py via
# the per-site DJANGO_SETTINGS_MODULE below.
DJANGO_SETTINGS_MODULE=config.settings.production

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

DEBUG=False

# COMMA-separated hostnames for this site (env.list splittar på komma -
# space-separerat gav DisallowedHost/400 i produktion 2026-08-29).
ALLOWED_HOSTS=adx.se,www.adx.se

# https://host for each origin that posts forms / admin. Comma-separated.
CSRF_TRUSTED_ORIGINS=https://adx.se,https://www.adx.se

# Postgres connection for THIS site.
DATABASE_URL=postgres://adx_dbuser:change-me@localhost:5432/adx_db

# Error monitoring (leave blank to disable). See README "Monitoring".
SENTRY_DSN=

# Identifies the site in logs / Sentry / uptime checks.
SITE_SLUG=adx

# Email - AWS SES SMTP credentials.
EMAIL_HOST=email-smtp.eu-north-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=info@adx.se
CUSTOMER_REPLY_TO_EMAIL=giovanni@adx.se
INQUIRY_NOTIFICATION_EMAIL=info@adx.se

# Publik bas-URL. Krävs i produktion: OAuth-metadatan för MCP-anslutningen
# (Claude/ChatGPT-appen) och AI:ns granskningslänkar byggs från den.
SITE_BASE_URL=https://adx.se

# AI-assistenten (Bedrock via instansrollen på servern).
ASSISTANT_PROVIDER=bedrock
ASSISTANT_BEDROCK_REGION=eu-central-1
ASSISTANT_BEDROCK_MODEL=eu.anthropic.claude-sonnet-5
# TOM på servern (instansrollen gäller). Lokalt: en profil i ~/.aws.
ASSISTANT_AWS_PROFILE=

# ADX Flamingo (apps/flamingo/README.md). Tomt = av: verktyget kör den
# manuella vägen (Editor-CSV, Google-kopplingen bockas av i panelen, inga sms).
# Förvaltarkontots (MCC) id, tio siffror.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# OAuth-klient (Webbprogram) i Google Cloud-projektet där Google Ads API är
# påslaget; åtkomsten (Explorer, Basic) söks för det projektet i Google Cloud
# Console. Inloggningen görs i /manage/ och nyckeln sparas krypterad i
# databasen. En API-nyckel (AIza...) duger inte: Google Ads kräver OAuth.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Valfri: en långlivad nyckel (refresh token) som vinner över den sparade.
GOOGLE_ADS_REFRESH_TOKEN=
# Tomt = v25. Varje version har ett slutdatum hos Google: byt innan dess.
GOOGLE_ADS_API_VERSION=
# Valfri och avvecklad hos Google (headern ignoreras sedan 2026-09-09).
GOOGLE_ADS_DEVELOPER_TOKEN=
# Av (tomt): konverteringarna går som CSV. Google tar inte emot nya användare
# av uploadClickConversions; slå på (true) bara om ADX bevisat har tillgång.
GOOGLE_ADS_UPLOAD_CONVERSIONS=
# Av (tomt): inbjudan när ett konto skapas kräver Googles tillåtelselista.
GOOGLE_ADS_INVITE_ON_CREATE=
# Valfri: krypterar Google-nyckeln i databasen. Tomt = härledd ur SECRET_KEY,
# och byts SECRET_KEY kopplar byrån Google igen. Skapa en med
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FLAMINGO_TOKEN_KEY=
GOOGLE_PLACES_API_KEY=
# 46elks: alla tre krävs innan något sms skickas.
ELKS_API_USERNAME=
ELKS_API_PASSWORD=
ELKS_SENDER=
# Tomt = https://adx.se respektive "ADX Flamingo affär".
FLAMINGO_LANDING_BASE_URL=
FLAMINGO_CONVERSION_NAME=
