# Copy to .env and fill in. NEVER commit the real .env.
# One .env per site. On the server it lives at:
#   /home/djangouser/sites/<site>/.env   (chmod 600)

# Which settings module to load. Maps to config/settings/<name>.py via
# the per-site DJANGO_SETTINGS_MODULE below.
DJANGO_SETTINGS_MODULE=config.settings.production

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

DEBUG=False

# COMMA-separated hostnames for this site (env.list splittar på komma -
# space-separerat gav DisallowedHost/400 i produktion 2026-08-29).
ALLOWED_HOSTS=adx.se,www.adx.se

# https://host for each origin that posts forms / admin. Comma-separated.
CSRF_TRUSTED_ORIGINS=https://adx.se,https://www.adx.se

# Postgres connection for THIS site.
DATABASE_URL=postgres://adx_dbuser:change-me@localhost:5432/adx_db

# Anslutningarna till Postgres (config/settings/base.py, DB_POOL). Lämna
# raderna utkommenterade: config/asgi.py slår på poolen för webbprocessen,
# och cron och manage.py ska inte ha den. ADX_DB_POOL=0 stänger av poolen
# (omstart av tjänsten). Grinden måste ligga under poolens storlek.
# ADX_DB_POOL=0
# ADX_DB_POOL_MAX_SIZE=12
# ADX_WEB_CONCURRENT_REQUESTS=6

# Error monitoring (leave blank to disable). See README "Monitoring".
SENTRY_DSN=

# Identifies the site in logs / Sentry / uptime checks.
SITE_SLUG=adx

# Övervakningen (apps/monitor/README.md). PageSpeed Insights och Chrome UX
# Report använder en API-nyckel (AIza...) från ett Google Cloud-projekt där
# PageSpeed Insights API och Chrome UX Report API är påslagna. CRUX_API_KEY
# tomt = PAGESPEED_API_KEY används för Chrome UX Report också.
PAGESPEED_API_KEY=
CRUX_API_KEY=

# Email - AWS SES SMTP credentials.
EMAIL_HOST=email-smtp.eu-north-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=info@adx.se
CUSTOMER_REPLY_TO_EMAIL=giovanni@adx.se
INQUIRY_NOTIFICATION_EMAIL=info@adx.se

# Publik bas-URL. Krävs i produktion: OAuth-metadatan för MCP-anslutningen
# (Claude/ChatGPT-appen) och AI:ns granskningslänkar byggs från den.
SITE_BASE_URL=https://adx.se

# AI-assistenten (Bedrock via instansrollen på servern).
ASSISTANT_PROVIDER=bedrock
ASSISTANT_BEDROCK_REGION=eu-central-1
ASSISTANT_BEDROCK_MODEL=eu.anthropic.claude-sonnet-5
# TOM på servern (instansrollen gäller). Lokalt: en profil i ~/.aws.
ASSISTANT_AWS_PROFILE=

# ADX Flamingo (apps/flamingo/README.md). Tomt = av: verktyget kör den
# manuella vägen (Editor-CSV, Google-kopplingen bockas av i panelen, inga sms).
# Förvaltarkontots (MCC) id, tio siffror.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# OAuth-klient (Webbprogram) i Google Cloud-projektet där Google Ads API är
# påslaget; åtkomsten (Explorer, Basic) söks för det projektet i Google Cloud
# Console. Inloggningen görs i /manage/ och nyckeln sparas krypterad i
# databasen. En API-nyckel (AIza...) duger inte: Google Ads kräver OAuth.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Valfri: en långlivad nyckel (refresh token) som vinner över den sparade.
GOOGLE_ADS_REFRESH_TOKEN=
# Tomt = v25. Varje version har ett slutdatum hos Google: byt innan dess.
GOOGLE_ADS_API_VERSION=
# Valfri och avvecklad hos Google (headern ignoreras sedan 2026-09-09).
GOOGLE_ADS_DEVELOPER_TOKEN=
# Konverteringarnas väg: datamanager (tomt, Data Manager API: slå på det i
# samma Cloud-projekt och koppla med behörigheten), googleads (gamla
# uploadClickConversions, bara med Googles tillåtelse) eller off (bara CSV).
FLAMINGO_CONVERSIONS_UPLOAD=
# Av (tomt): inbjudan när ett konto skapas kräver Googles tillåtelselista.
GOOGLE_ADS_INVITE_ON_CREATE=
# Valfri: krypterar Google-nyckeln i databasen. Tomt = härledd ur SECRET_KEY,
# och byts SECRET_KEY kopplar byrån Google igen. Skapa en med
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FLAMINGO_TOKEN_KEY=
GOOGLE_PLACES_API_KEY=
# 46elks: alla tre krävs innan Flamingo skickar något sms. Samma konto används
# av SMS-API:t (apps/sms), som bara behöver de två första. De äldre namnen
# SMS_46ELKS_USER och SMS_46ELKS_PASSWORD fungerar också.
ELKS_API_USERNAME=
ELKS_API_PASSWORD=
ELKS_SENDER=
# SMS-API:t för kunderna (apps/sms/README.md). Utan SMS_SEND_LIVE=true går
# varje sms till 46elks med dryrun: inget skickas. Sätt true bara i drift.
SMS_PROVIDER=46elks
SMS_SEND_LIVE=
# Tomt = SITE_BASE_URL. Leveransrapporterna kräver en publik https-adress.
SMS_CALLBACK_BASE_URL=
# Valfri IP-spärr för leveransrapporterna, kommaseparerad. 46elks adresser:
# 176.10.154.199,85.24.146.132,185.39.146.243,2001:9b0:2:902::199
SMS_DLR_ALLOWED_IPS=
# Gränser per nyckel: 20 anrop per sekund, 60 sms per minut och 5000 per dygn
# om raderna saknas. Ta bort # för att ändra (en tom rad är inget tal).
# SMS_RATE_PER_SECOND=20
# SMS_RATE_PER_MINUTE=60
# SMS_DAILY_MAX_PER_KEY=5000
# Tomt = https://adx.se respektive "ADX Flamingo affär".
FLAMINGO_LANDING_BASE_URL=
FLAMINGO_CONVERSION_NAME=
# Utvalda omdömen från Reco är på. Ta bort # för att stänga av dem för alla
# (en tom rad vore också av, så låt raden vara bortkommenterad annars).
# FLAMINGO_RECO_SELECTED_ENABLED=false

# Flamingo 2.0: kontakter och utskick (apps/utskick/README.md, C.4). Inget
# skickas förrän byrån slagit på brytarna på /manage/utskick/nodstopp/.
# Nycklarna KRÄVS i produktion (sajten startar inte utan dem) och är stabila
# för alltid: byts UTSKICK_HASH_KEY hittar ingen spärr sin adress längre.
# Skapa med: python -c "import secrets; print(secrets.token_urlsafe(48))"
# och spara kopior i lösenordshanteraren. Lokalt: tomt = härledd ur SECRET_KEY.
UTSKICK_HASH_KEY=
UTSKICK_LINK_KEY=
# Avsändaren för bekräftelsemejlen. Tomt = bekrafta@utskick.adx.se.
UTSKICK_DOI_FROM=
# Tickens tidsbudget i sekunder och minnestak i MB. Ta bort # för att ändra.
# UTSKICK_TICK_SECONDS=50
# UTSKICK_TICK_MAX_MB=700
# Av (tomt) = ingen post från utskick alls. Sätt true först när SES i
# eu-west-1 gett produktionsåtkomst (README J, S1-checklistan steg 6).
UTSKICK_EMAIL_LIVE=
# Rollen adx-utskick (H.8) och dess external id (32 slumptecken). Tomt =
# ingen AWS; lokalt används ADX_AWS_PROFILE.
UTSKICK_AWS_ROLE_ARN=
UTSKICK_AWS_EXTERNAL_ID=
# Tomt = eu-west-1 respektive utskick.adx.se.
UTSKICK_SES_REGION=
UTSKICK_ADX_MAIL_DOMAIN=
# S2: länkvärdarna (bara utskickens länkar svarar där). Tomt = k.adx.se och
# klick.adx.se (lokalt k.localhost och klick.localhost). I produktion läggs de
# också SIST i ALLOWED_HOSTS (,k.adx.se,klick.adx.se) och
# CSRF_TRUSTED_ORIGINS (,https://k.adx.se,https://klick.adx.se); starta sedan
# om adx med systemctl restart adx (reload läser inte om .env).
UTSKICK_LINK_HOSTS=
# Tomt = https://k.adx.se respektive https://klick.adx.se.
UTSKICK_SMS_LINK_BASE=
UTSKICK_EMAIL_LINK_BASE=
# Det delade svarsnumret hos 46elks. Tomt = +46766860046.
UTSKICK_REPLY_NUMBER=
# Hemligheten i adressen för inkommande sms (minst 32 tecken, samma som i
# numrets sms_url hos 46elks). Tomt = inkommande sms är av. Kräver också
# SMS_DLR_ALLOWED_IPS i produktion.
# Skapa med: python -c "import secrets; print(secrets.token_urlsafe(32))"
UTSKICK_ELKS_INBOUND_TOKEN=
# Svaren på STOPP/START och ägarens sms om svar går direkt efter
# webbanropet (en kort tråd i webbprocessen); ticken är reserven. På om
# raden saknas; false = bara ticken skickar dem.
# UTSKICK_KICK=true
# Utskickens del av minutgränserna: 45 sms per kund och 60 för hela byrån
# om raderna saknas. Ta bort # för att ändra.
# UTSKICK_SMS_ACCOUNT_PER_MINUTE=45
# UTSKICK_SMS_GLOBAL_PER_MINUTE=60
# S3: e-post i Brev. Resurserna skapas av server/aws-utskick-s3.sh (efter
# server/aws-utskick-role.sh), som skriver ut raderna att klistra in här.
# Tomma rader = händelserna och de inkommande mejlen är av.
# Konfigurationssetet i SES eu-west-1. Tomt = adx-utskick.
UTSKICK_SES_CONFIGURATION_SET=
# Mejl från utskick.adx.se per kund och månad, och mejl per sekund för hela
# ADX (högst 80 % av SES takt). Ta bort # för att ändra.
# UTSKICK_ADX_MONTHLY_MAIL_CAP=2000
# UTSKICK_EMAIL_PER_SECOND=10
# Domänen för svaren på mejl (Reply-To s+<token>@...). Tomt = svar.utskick.adx.se.
UTSKICK_REPLY_DOMAIN=
# Hinken för inkommande svar (prefixet in/) och köerna för SES-händelserna
# och de inkommande mejlen (https://sqs.eu-west-1.amazonaws.com/<konto>/<kö>).
UTSKICK_SES_INBOUND_BUCKET=
UTSKICK_SQS_EVENTS_URL=
UTSKICK_SQS_INBOUND_URL=
