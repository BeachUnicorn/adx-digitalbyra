# Copy to .env and fill in. NEVER commit the real .env.
# One .env per site. On the server it lives at:
#   /home/djangouser/sites/<site>/.env   (chmod 600)

# Which settings module to load. Maps to config/settings/<name>.py via
# the per-site DJANGO_SETTINGS_MODULE below.
DJANGO_SETTINGS_MODULE=config.settings.production

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me

DEBUG=False

# Space-separated hostnames for this site.
ALLOWED_HOSTS=adx.se www.adx.se

# https://host for each origin that posts forms / admin.
CSRF_TRUSTED_ORIGINS=https://adx.se https://www.adx.se

# Postgres connection for THIS site.
DATABASE_URL=postgres://adx_dbuser:change-me@localhost:5432/adx_db

# Error monitoring (leave blank to disable). See README "Monitoring".
SENTRY_DSN=

# Identifies the site in logs / Sentry / uptime checks.
SITE_SLUG=adx

# Email - AWS SES SMTP credentials.
EMAIL_HOST=email-smtp.eu-north-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=info@adx.se
INQUIRY_NOTIFICATION_EMAIL=info@adx.se

# Publik bas-URL. Krävs i produktion: OAuth-metadatan för MCP-anslutningen
# (Claude/ChatGPT-appen) och AI:ns granskningslänkar byggs från den.
SITE_BASE_URL=https://www.adx.se

# AI-assistenten (Bedrock via instansrollen på servern).
ASSISTANT_PROVIDER=bedrock
ASSISTANT_BEDROCK_REGION=eu-central-1
ASSISTANT_BEDROCK_MODEL=eu.anthropic.claude-opus-4-6-v1
# TOM på servern (instansrollen gäller). Lokalt: en profil i ~/.aws.
ASSISTANT_AWS_PROFILE=
